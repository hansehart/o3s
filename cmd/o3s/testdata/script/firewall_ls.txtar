# The table lists every host with its ports, secret and who needs it
exec o3s firewall ls
cmp stdout want.txt
! stderr .

-- o3s.json --
{
  "$schema": "./.o3s/o3s.schema.json",
  "stores": [],
  "hosts": [
    {"name": "example.com", "ports": [22, 443], "by": ["user"]},
    {"name": "api.example.net", "ports": [443], "secret": "EXAMPLE_NET_KEY", "inject": ["header"], "by": ["registry.example.com/features/alpha"]}
  ]
}
-- want.txt --
HOST             PORTS   SECRET           BY
example.com      22,443                   user
api.example.net  443     EXAMPLE_NET_KEY  registry.example.com/features/alpha
