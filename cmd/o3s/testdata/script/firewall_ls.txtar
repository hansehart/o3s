# The table lists every host with its ports, secret and who needs it
exec o3s firewall ls
cmp stdout want.txt
! stderr .

-- o3s.json --
{
  "$schema": "./.o3s/o3s.schema.json",
  "stores": [],
  "hosts": [
    {"name": "github.com", "ports": [22, 443], "by": ["user"]},
    {"name": "api.openai.com", "ports": [443], "secret": "OPENAI_API_KEY", "inject": ["header"], "by": ["ghcr.io/hansehart/devcontainer-features/codex"]}
  ]
}
-- want.txt --
HOST            PORTS   SECRET          BY
github.com      22,443                  user
api.openai.com  443     OPENAI_API_KEY  ghcr.io/hansehart/devcontainer-features/codex
