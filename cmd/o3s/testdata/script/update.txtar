# A new home already holds what the binary and its stores ship, and a dev build leaves itself alone
exec o3s init
exec o3s update
stdout '^o3s dev builds update with go install or install\.sh$'
stdout '^Up to date$'

# Without a terminal and without --yes, nothing answers, so the update writes nothing
cp edited.yaml .devcontainer/compose.yaml
! exec o3s update
stdout '^  ~ compose\.yaml$'
stderr 'pass --yes'
stderr 'for usage'
cmp .devcontainer/compose.yaml edited.yaml

# --yes brings the stack back to what the binary ships
exec o3s update --yes
stdout '^\.devcontainer/$'
stdout '^  ~ compose\.yaml$'
stdout '^Updated, rebuilding the cage$'
cmpenv devcontainer.log want.log
exec o3s update
stdout '^Up to date$'

# A feature on an older major version moves to the store's
exec o3s feature add $REGISTRY/features/tool:1
exec o3s update --yes
stdout '/features/tool   1 → 2$'
! stdout 'Restarted'
grep ${REGISTRY@R}/features/tool:2 .devcontainer/devcontainer.json
exec o3s update
stdout '^Up to date$'

-- want.log --
up --workspace-folder $WORK --remove-existing-container
-- edited.yaml --
services: {}
