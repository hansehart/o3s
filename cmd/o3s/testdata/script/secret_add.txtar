# A value arrives on stdin, is stored, and never shows in the output
stdin value.txt
exec o3s secret add EXAMPLE_TOKEN
stdout '^Stored EXAMPLE_TOKEN$'
stdout '^Bind it to a host with: o3s firewall add <host> --secret EXAMPLE_TOKEN$'
! stdout 's3cr3t'
cmp .config/o3s/secrets.env stored.env

# A new value for a bound name reports the rotation and skips the hint
exec o3s firewall add api.example.com --secret EXAMPLE_TOKEN
stdin rotated.txt
exec o3s secret add EXAMPLE_TOKEN
stdout '^EXAMPLE_TOKEN$'
stdout '^  ~ value replaced$'
stdout '^Stored EXAMPLE_TOKEN$'
! stdout 'Bind it'
! stdout 'r0tated'
cmp .config/o3s/secrets.env rotated.env

# An empty value is turned away as a usage error and leaves the file as it was
! exec o3s secret add EXAMPLE_TOKEN
stderr 'invalid value for EXAMPLE_TOKEN'
stderr 'for usage'
cmp .config/o3s/secrets.env rotated.env

# A name outside the rules is turned away
stdin value.txt
! exec o3s secret add example_token
stderr 'invalid secret "example_token"'

# A value typed at a terminal is turned away, so the value arrives through a pipe
ttyin -stdin value.txt
! exec o3s secret add EXAMPLE_TOKEN
stderr 'pipe the value'

-- o3s.json --
{"$schema": "./.o3s/o3s.schema.json", "stores": [], "hosts": []}
-- value.txt --
s3cr3t
-- rotated.txt --
r0tated
-- stored.env --
EXAMPLE_TOKEN=s3cr3t
-- rotated.env --
EXAMPLE_TOKEN=r0tated
