# A host the user alone needs leaves the allowlist
exec o3s firewall rm example.com
stdout '^Removed example.com$'

# A host a feature still needs stays, and the feature is named
exec o3s firewall rm api.example.net
stdout '^Kept api.example.net, still needed by registry.example.com/features/alpha$'

# The file holds the host for the feature alone
cmp o3s.json want.json

# A host only features brought stays with them
! exec o3s firewall rm api.example.org
stderr 'needed by features alone'

# A host the allowlist lacks is turned away
! exec o3s firewall rm absent.example
stderr 'unknown host absent.example'

-- o3s.json --
{
  "$schema": "./.o3s/o3s.schema.json",
  "stores": [],
  "hosts": [
    {"name": "api.example.org", "ports": [443], "by": ["registry.example.com/features/beta"]},
    {"name": "example.com", "ports": [22, 443], "by": ["user"]},
    {"name": "api.example.net", "ports": [443], "by": ["registry.example.com/features/alpha", "user"]}
  ]
}
-- want.json --
{
  "$schema": "./.o3s/o3s.schema.json",
  "stores": [],
  "hosts": [
    {
      "name": "api.example.net",
      "ports": [
        443
      ],
      "by": [
        "registry.example.com/features/alpha"
      ]
    },
    {
      "name": "api.example.org",
      "ports": [
        443
      ],
      "by": [
        "registry.example.com/features/beta"
      ]
    }
  ]
}
