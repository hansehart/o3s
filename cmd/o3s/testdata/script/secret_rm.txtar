# Removing a name drops its lines and keeps every other line
exec o3s secret rm EXAMPLE_TOKEN
stdout '^Removed EXAMPLE_TOKEN$'
cmp .config/o3s/secrets.env want.env

# A name the file lacks is turned away
! exec o3s secret rm EXAMPLE_TOKEN
stderr 'unknown secret EXAMPLE_TOKEN'

-- o3s.json --
{"$schema": "./.devcontainer/o3s.schema.json", "stores": [], "hosts": []}
-- .config/o3s/secrets.env --
# real API tokens for the egress proxy
EXAMPLE_TOKEN=s3cr3t
-- want.env --
# real API tokens for the egress proxy
