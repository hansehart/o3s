# A bound name without a value shows as empty, with the hosts that name it
exec o3s secret ls
cmp stdout empty.txt

# A stored value shows as set, never as the value
stdin value.txt
exec o3s secret add EXAMPLE_TOKEN
exec o3s secret ls
cmp stdout set.txt
! stdout 's3cr3t'

-- o3s.json --
{"$schema": "./.o3s/o3s.schema.json", "stores": [], "hosts": [
  {"name": "api.example.com", "ports": [443], "secret": "EXAMPLE_TOKEN", "inject": ["header"], "by": ["user"]},
  {"name": "example.org", "ports": [443], "secret": "EXAMPLE_TOKEN", "inject": ["header"], "by": ["user"]}
]}
-- .config/o3s/secrets.env --
EXAMPLE_TOKEN=
-- value.txt --
s3cr3t
-- empty.txt --
NAME           VALUE  HOSTS
EXAMPLE_TOKEN  empty  api.example.com, example.org
-- set.txt --
NAME           VALUE  HOSTS
EXAMPLE_TOKEN  set    api.example.com, example.org
