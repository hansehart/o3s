# The user's own home folder holds the host's secrets and CA, which the cage would see, so it is turned away
cd $WORK
! exec o3s init
stderr 'needs a folder of its own'
! exists $WORK/o3s.json
! exists $WORK/.devcontainer

# An empty folder becomes a home with the settings of a new home, the stack, and a prepared host
mkdir home
cd home
exec o3s init
stdout '^Wrote '$WORK'/home/o3s.json$'
stdout '^Wrote '$WORK'/home/.devcontainer/ \([0-9]+ files\)$'
stdout '^Wrote '$WORK'/home/home.code-workspace$'
stdout '^Made the proxy''s CA in '$WORK'/.local/state/o3s/proxy$'
stdout '^  code '$WORK'/home/home.code-workspace +open it, then reopen in the container$'
stdout '^Next steps:$'
cmp o3s.json $WORK/want.json
exists .devcontainer/devcontainer.json
exists .devcontainer/compose.yaml
exists .devcontainer/lifecycle/post-start.sh
! exists .devcontainer/compose.dev.yaml
exists .devcontainer/.env
grep '^O3S_PROXY_DIR='$WORK'/.local/state/o3s/proxy$' .devcontainer/.env
grep '^O3S_SECRETS_DIR='$WORK'/.config/o3s$' .devcontainer/.env
grep '^O3S_SOCKET_DIR='$WORK'/.local/state/o3s/[0-9a-f]{12}/docker-host$' .devcontainer/.env
exists $WORK/.local/state/o3s/proxy/mitmproxy-ca.crt
! exists $WORK/.config/o3s/mitmproxy-ca.crt
exists $WORK/.config/o3s/secrets.env
exec sh -c 'grep -q "\"path\": \"$WORK/home\"" "$WORK"/.local/state/o3s/*/home.json'
exec sh -c 'test -d "$WORK"/.local/state/o3s/*/docker-host'
grep '"initializeCommand": "o3s init"' .devcontainer/devcontainer.json

# The new home works with every command
exec o3s firewall ls
stdout '^HOST'
exec o3s secret ls
stdout '^NAME'

# Every start prepares the host again and keeps the home and its CA as they are
cp $WORK/.local/state/o3s/proxy/mitmproxy-ca.pem $WORK/ca.pem
cp .devcontainer/.env $WORK/env
exec o3s init
! stdout 'Wrote|Next steps|differs'
stdout '^The proxy''s CA is ready in '$WORK'/.local/state/o3s/proxy$'
cmp o3s.json $WORK/want.json
cmp $WORK/.local/state/o3s/proxy/mitmproxy-ca.pem $WORK/ca.pem
cmp .devcontainer/.env $WORK/env

# A home that lost its settings gets those of a new home back
rm o3s.json
exec o3s init
stdout '^Wrote '$WORK'/home/o3s.json$'
cmp o3s.json $WORK/want.json

# A secret a host waits for is named with the command that gives it its value
exec o3s firewall add example.com --secret EXAMPLE_TOKEN
exec o3s init
stdout '^⚠ EXAMPLE_TOKEN waits for its value: echo "\$TOKEN" \| o3s secret add EXAMPLE_TOKEN$'

# A stack that differs from this o3s is pointed at update, and left as it is
cp $WORK/edited.yaml .devcontainer/compose.yaml
exec o3s init
stdout '^The stack differs from this o3s, run o3s update$'
cmp .devcontainer/compose.yaml $WORK/edited.yaml

-- edited.yaml --
services: {}
-- want.json --
{
  "$schema": "./.devcontainer/o3s.schema.json",
  "stores": [
    {
      "id": "ghcr.io/devcontainers/features"
    },
    {
      "id": "ghcr.io/hansehart/devcontainer-features"
    }
  ],
  "hosts": []
}
