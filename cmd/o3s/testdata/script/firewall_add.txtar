# A new host takes port 443 and needs no report of changed fields
exec o3s firewall add github.com
stdout '^Allowed github.com:443$'
! stdout '~'
! stderr .

# An update lists each field it changed before it confirms
exec o3s firewall add github.com --port 22 --port 443
stdout '^github.com$'
stdout '^  ~ ports 443 → 22,443$'
stdout '^Allowed github.com:22,443$'

# A secret goes where the inject sites name, or into the header
exec o3s firewall add api.openai.com --secret OPENAI_API_KEY --inject header --inject body
stdout '^Allowed api.openai.com:443 with OPENAI_API_KEY in header, body$'
exec o3s firewall add api.anthropic.com --secret ANTHROPIC_API_KEY
stdout '^Allowed api.anthropic.com:443 with ANTHROPIC_API_KEY in header$'

# The file holds the hosts in apex order
cmp o3s.json want.json

# A host outside the rules is turned away as a usage error and leaves the file as it was
! exec o3s firewall add GitHub.com
stderr 'invalid host "GitHub.com"'
stderr 'for usage'
cmp o3s.json want.json

# A port outside the range is turned away
! exec o3s firewall add github.com --port 70000
stderr 'invalid port 70000'

# Inject sites without a secret are turned away
! exec o3s firewall add example.com --inject body
stderr 'inject without a secret'

-- o3s.json --
{
  "$schema": "./.o3s/o3s.schema.json",
  "stores": [],
  "hosts": []
}
-- want.json --
{
  "$schema": "./.o3s/o3s.schema.json",
  "stores": [],
  "hosts": [
    {
      "name": "api.anthropic.com",
      "ports": [
        443
      ],
      "secret": "ANTHROPIC_API_KEY",
      "inject": [
        "header"
      ],
      "by": [
        "user"
      ]
    },
    {
      "name": "github.com",
      "ports": [
        22,
        443
      ],
      "by": [
        "user"
      ]
    },
    {
      "name": "api.openai.com",
      "ports": [
        443
      ],
      "secret": "OPENAI_API_KEY",
      "inject": [
        "header",
        "body"
      ],
      "by": [
        "user"
      ]
    }
  ]
}
