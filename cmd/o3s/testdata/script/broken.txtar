# A hand-edited file that breaks a rule stops every command and names the entry
! exec o3s firewall ls
stderr 'o3s.json holds a broken entry'
stderr 'port 70000'
! stderr 'for usage'

-- o3s.json --
{"$schema": "./.devcontainer/o3s.schema.json", "stores": [], "hosts": [
  {"name": "example.com", "ports": [70000], "by": ["user"]}
]}
